<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project Configuration -->

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <UseRidGraph>true</UseRidGraph>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>PrtgAPI.Tests.UnitTests</AssemblyName>
    <RootNamespace>PrtgAPI.Tests.UnitTests</RootNamespace>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PrtgAPI.GeneratedCode</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Import Project="..\..\build\Common.props" />

  <!-- Content -->

  <ItemGroup>
    <!-- Re-include AssemblyInfo for specifying MSTest Parallelization mode -->
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- References -->
  <!-- For PackageReference versions please see Directory.Packages.props -->

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="PowerShellStandard.Library" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\PrtgAPI\PrtgAPI.csproj" />
    <ProjectReference Include="..\PrtgAPI.PowerShell\PrtgAPI.PowerShell.csproj" />
  </ItemGroup>
</Project>
